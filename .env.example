# Environment Configuration for LLM Security Scanner
ENVIRONMENT=development
LOG_LEVEL=INFO
# Production requires a random secret of at least 32 characters and signed HS256 Bearer JWTs.
JWT_SECRET_KEY=

# Backend API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="LLM Security Scanner"
VERSION="1.0.0"
HOST=127.0.0.1
PORT=8000

# Database Configuration
# Default is local SQLite. PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/llm_scanner
DATABASE_URL=sqlite:///./llm_security_scanner.db

# Scanner Engine Configuration
SCANNER_REQUEST_TIMEOUT_SECONDS=10.0
SCANNER_MAX_CONCURRENT_TESTS=5
SCANNER_MAX_PAYLOAD_SIZE_BYTES=32768
ALLOWED_HOSTS=["127.0.0.1", "localhost"]

# Demo RAG Configuration
DEMO_RAG_HOST=127.0.0.1
DEMO_RAG_PORT=8000
DEMO_RAG_VULNERABLE_MODE=true

# ML Classifier Configuration
MODEL_DIR=models
MODEL_FILENAME=baseline_threat_classifier.joblib
DETECTION_THRESHOLD=0.65
