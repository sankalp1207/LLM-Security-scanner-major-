# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/
ENV/

# Configuration and secrets
.env
.env.*
!.env.example

# Databases
*.db
*.sqlite
*.sqlite3

# Large generated ML artifacts (keep .gitkeep in models/)
models/*.joblib
models/*.pkl
!models/.gitkeep

# Logs and runtime files
*.log
logs/

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.idea/
.vscode/
*.swp

# APK builds (allow root release apk for direct download)
*.apk
!app-debug.apk

